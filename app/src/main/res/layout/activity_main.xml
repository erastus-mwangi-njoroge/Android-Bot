<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:orientation="vertical" android:padding="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@mipmap/ic_launcher" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Academia Bot"
                android:textColor="@color/text" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.2"
                android:text="INTELLIGENCE. AUTOMATED." android:textColor="@color/accent_hi" android:textSize="8sp" />
        </LinearLayout>
        <TextView android:id="@+id/tvAuth" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_card" android:paddingStart="10dp" android:paddingTop="6dp"
            android:paddingEnd="10dp" android:paddingBottom="6dp" android:text="●  Auth: Not verified"
            android:textColor="@color/red" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:orientation="horizontal">
        <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="6dp" android:orientation="vertical" android:padding="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:letterSpacing="0.1" android:text="STATUS" android:textColor="@color/muted" android:textSize="9sp" />
            <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Offline" android:textColor="@color/red" android:textSize="16sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="6dp" android:orientation="vertical" android:padding="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:letterSpacing="0.1" android:text="UPTIME" android:textColor="@color/muted" android:textSize="9sp" />
            <TextView android:id="@+id/tvUptime" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="00:00:00" android:textColor="@color/text" android:textSize="16sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="6dp" android:orientation="vertical" android:padding="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:letterSpacing="0.1" android:text="ORDERS TAKEN" android:textColor="@color/muted" android:textSize="9sp" />
            <TextView android:id="@+id/tvOrders" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0" android:textColor="@color/text" android:textSize="16sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="6dp" android:orientation="vertical" android:padding="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:letterSpacing="0.1" android:text="LAST ORDER SEEN" android:textColor="@color/muted" android:textSize="9sp" />
            <TextView android:id="@+id/tvLast" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="--:--:--" android:textColor="@color/text" android:textSize="16sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:orientation="horizontal">
        <Button android:id="@+id/tabDash" style="@style/Btn" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/btn_primary" android:text="Setup" />
        <Button android:id="@+id/tabLog" style="@style/Btn" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:background="@drawable/btn_ghost" android:text="Live log" />
        <Button android:id="@+id/tabBrowser" style="@style/Btn" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="4dp" android:background="@drawable/btn_ghost" android:text="Browser" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_marginTop="10dp" android:layout_weight="1">

        <ScrollView android:id="@+id/panelDash" android:layout_width="match_parent"
            android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView style="@style/CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Account" />
                    <EditText android:id="@+id/etEmail" style="@style/Input" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="Email"
                        android:inputType="textEmailAddress" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:orientation="horizontal">
                        <EditText android:id="@+id/etPass" style="@style/Input" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1" android:hint="Password"
                            android:inputType="textPassword" />
                        <Button android:id="@+id/btnShow" style="@style/Btn" android:layout_width="wrap_content"
                            android:layout_height="match_parent" android:layout_marginStart="6dp"
                            android:background="@drawable/btn_ghost" android:paddingStart="14dp"
                            android:paddingEnd="14dp" android:text="Show" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:orientation="horizontal">
                        <EditText android:id="@+id/etToken" style="@style/Input" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:hint="Authentication token" android:inputType="textNoSuggestions" />
                        <Button android:id="@+id/btnVerify" style="@style/Btn" android:layout_width="wrap_content"
                            android:layout_height="match_parent" android:layout_marginStart="6dp"
                            android:background="@drawable/btn_ghost" android:paddingStart="14dp"
                            android:paddingEnd="14dp" android:text="Verify" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:text="Tokens are generated in the desktop app."
                        android:textColor="@color/muted" android:textSize="11sp" />
                    <CheckBox android:id="@+id/cbRemember" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="Remember password on this phone" android:textColor="@color/text" />
                </LinearLayout>

                <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:orientation="vertical">
                    <TextView style="@style/CardTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Run options" />
                    <CheckBox android:id="@+id/cbImages" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:text="Block images (faster, lighter)" android:textColor="@color/text" />
                    <CheckBox android:id="@+id/cbVerbose" android:layout_width="wrap_content" android:layout_height="wrap_content"
                         android:text="Verbose log" android:textColor="@color/text" />
                    <CheckBox android:id="@+id/cbKeepOn" android:layout_width="wrap_content" android:layout_height="wrap_content"
                         android:text="Keep screen on while app is open" android:textColor="@color/text" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="Auto-refresh every (min)" android:textColor="@color/text" />
                        <EditText android:id="@+id/etRefresh" style="@style/Input" android:layout_width="80dp"
                            android:layout_height="wrap_content" android:gravity="center" android:inputType="number"
                            android:maxLength="2" android:text="10" />
                    </LinearLayout>
                    <Button android:id="@+id/btnBattery" style="@style/Btn" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="10dp"
                        android:background="@drawable/btn_ghost" android:text="Allow running in background (battery)" />
                </LinearLayout>

                <Button android:id="@+id/btnStart" style="@style/Btn" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:background="@drawable/btn_primary" android:minHeight="52dp" android:text="▶  Start bot"
                    android:textColor="#ffffff" android:textSize="16sp" />
                <Button android:id="@+id/btnStop" style="@style/Btn" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:background="@drawable/btn_danger" android:minHeight="52dp" android:text="■  Stop bot"
                    android:textColor="#ffffff" android:textSize="16sp" android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout android:id="@+id/panelLog" android:layout_width="match_parent"
            android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
            <Button android:id="@+id/btnClear" style="@style/Btn" android:layout_width="wrap_content"
                android:layout_height="36dp" android:layout_gravity="end" android:background="@drawable/btn_ghost"
                android:minHeight="0dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="Clear" />
            <ScrollView android:id="@+id/scrollLog" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_marginTop="8dp" android:layout_weight="1" android:background="@drawable/bg_log">
                <TextView android:id="@+id/tvLog" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:padding="10dp" android:textColor="@color/text"
                    android:textIsSelectable="true" android:textSize="11sp" android:typeface="monospace" />
            </ScrollView>
        </LinearLayout>

        <FrameLayout android:id="@+id/panelBrowser" android:layout_width="match_parent"
            android:layout_height="match_parent" android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
