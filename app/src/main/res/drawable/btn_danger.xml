<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#ff7683" /><corners android:radius="10dp" /><stroke android:width="1dp" android:color="#ff7683" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/red" /><corners android:radius="10dp" /><stroke android:width="1dp" android:color="@color/red" /></shape>
    </item>
</selector>
